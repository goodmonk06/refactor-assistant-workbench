// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Codebase {
  id            String         @id @default(cuid())
  name          String
  repoPath      String?
  githubUrl     String?
  mainLanguage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  scanRuns      ScanRun[]
  refactorPlans RefactorPlan[]

  @@map("codebases")
}

model ScanRun {
  id          String    @id @default(cuid())
  codebaseId  String
  codebase    Codebase  @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    // "running", "completed", "failed"
  summaryJson Json?
  errorMessage String?
  createdAt   DateTime  @default(now())

  @@map("scan_runs")
}

model RefactorPlan {
  id                  String         @id @default(cuid())
  codebaseId          String
  codebase            Codebase       @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  title               String
  descriptionMarkdown String?
  goal                String?        // The original goal/prompt used to generate this plan
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tasks               RefactorTask[]

  @@map("refactor_plans")
}

model RefactorTask {
  id                  String       @id @default(cuid())
  planId              String
  plan                RefactorPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title               String
  descriptionMarkdown String?
  areaPath            String?      // e.g., "src/core/scheduler"
  status              String       @default("todo") // "todo", "in_progress", "done"
  priority            Int          @default(0)      // Higher number = higher priority
  orderIndex          Int          @default(0)      // For ordering tasks
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("refactor_tasks")
}
